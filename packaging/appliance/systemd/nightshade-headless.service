# Nightshade headless appliance unit.
#
# Runs the Linux desktop bundle (apps/desktop) with --headless, which routes
# into apps/desktop/lib/main_headless.dart: headless API server (default port
# 8080), mDNS `_nightshade._tcp` advertisement, UDP discovery beacons
# (45679), LAN push broadcaster, OTA update endpoints, disk-space watchdog.
#
# All operator configuration lives in /etc/nightshade/headless.env (see
# headless.env.example). Install with install.sh from this directory.
#
# NOTE on xvfb-run: even in headless app mode the Flutter GTK embedder
# initialises a display connection, so the daemon is wrapped in a throwaway
# X server. This mirrors the smoke test in scripts/docker_build_linux.sh.
# Requires the xvfb package (Debian/RPi OS: `apt install xvfb`).

[Unit]
Description=Nightshade headless astrophotography server
Documentation=https://github.com/nightshade/nightshade file:///opt/nightshade/docs/headless-secure-setup.md
# Bind after the network is actually routable, not just configured — the
# server enumerates interfaces at startup to print/advertise its LAN URL,
# and mDNS registration needs a live interface.
Wants=network-online.target
After=network-online.target
# Avahi is optional (mDNS advertisement degrades gracefully to UDP
# discovery), but if it is installed, start after it.
After=avahi-daemon.service
# Crash-loop guard (pairs with Restart/RestartSec below): give up after 10
# failures in 5 min so a genuinely broken install surfaces in `systemctl
# status` instead of flapping forever. These are [Unit] keys — placed in
# [Service] systemd silently ignores them (systemd-analyze verify warns).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=nightshade
Group=nightshade

# Operator config: tokens, port, TLS, OTA server, CORS. Created by install.sh
# with mode 0640 root:nightshade so the token is not world-readable.
EnvironmentFile=/etc/nightshade/headless.env

# State layout. path_provider resolves the app-support dir under $HOME, so
# pinning HOME keeps the Drift DB, pairing DB, TLS cert, push_config.json,
# and OTA state all under /var/lib/nightshade.
Environment=HOME=/var/lib/nightshade
Environment=NIGHTSHADE_DATA_DIR=/var/lib/nightshade/data
WorkingDirectory=/var/lib/nightshade
# systemd creates /var/lib/nightshade (and fixes ownership) if missing.
StateDirectory=nightshade
StateDirectoryMode=0750

ExecStart=/usr/bin/xvfb-run -a /opt/nightshade/bundle/nightshade_desktop --headless

# Unattended overnight imaging: always come back. The 5 s backoff avoids a
# tight crash loop hammering USB devices; the StartLimit* keys in [Unit]
# above still bound the retries.
Restart=always
RestartSec=5

# Give the in-process shutdown path (SIGTERM handler in main_headless.dart:
# stop sequencer streams, unregister mDNS, close the API server, dispose the
# OTA stack) time to finish before SIGKILL.
TimeoutStopSec=30
KillSignal=SIGTERM

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nightshade
# Capture path may live on an external disk; add it here if so, e.g.:
# ReadWritePaths=/var/lib/nightshade /mnt/captures
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
# PrivateDevices is intentionally OFF: the server drives cameras, mounts,
# filter wheels and focusers over /dev/bus/usb and /dev/ttyUSB*/ttyACM*.
# Device access is granted via the supplementary groups below + udev.
PrivateDevices=no
SupplementaryGroups=dialout video plugdev
# MemoryDenyWriteExecute is intentionally OFF: the Dart VM maps a small
# amount of W+X memory even in AOT release builds.

[Install]
WantedBy=multi-user.target
