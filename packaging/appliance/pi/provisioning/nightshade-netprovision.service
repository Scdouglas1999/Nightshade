# Wi-Fi hotspot fallback provisioning for the Nightshade Pi appliance.
# Installed + enabled by build_pi_image.sh.
#
# Runs at every boot; exits immediately when a known network connects
# within the grace period. Otherwise it holds a "Nightshade-XXXX" hotspot
# + captive credentials portal until the operator provisions Wi-Fi.
# It does NOT block the boot (Type=simple, no other unit After=us except
# nightshade-firstboot, which genuinely needs the network).

[Unit]
Description=Nightshade Wi-Fi fallback provisioning (hotspot + portal)
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=simple
# Root needed: nmcli hotspot control + binding port 80 for the portal.
ExecStart=/usr/local/lib/nightshade/nightshade-netprovision.sh
RuntimeDirectory=nightshade-provision
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=10
# Environment knobs (also see headless.env for the app itself):
#Environment=NIGHTSHADE_PROVISION_WAIT=90
#Environment=NIGHTSHADE_HOTSPOT_PASS=nightshade

[Install]
WantedBy=multi-user.target
