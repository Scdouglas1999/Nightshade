# One-shot first-boot setup for the Nightshade Pi appliance.
# Installed + enabled by build_pi_image.sh. nightshade-headless.service
# orders itself After= this unit via a drop-in, so the daemon never starts
# before xvfb exists.

[Unit]
Description=Nightshade appliance first-boot setup (xvfb install)
ConditionPathExists=!/var/lib/nightshade-firstboot.done
# apt needs working DNS + routes; the provisioning service (hotspot
# fallback) is what gets us there on a box with no known Wi-Fi.
Wants=network-online.target
After=network-online.target nightshade-netprovision.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/nightshade/nightshade-firstboot.sh
# apt over slow Wi-Fi on a Pi Zero 2 can be genuinely slow.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
